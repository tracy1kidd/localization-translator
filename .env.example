# 复制本文件为 .env 后按需填写（.env 已被 .gitignore 排除，切勿提交）
# 所有密钥一律走环境变量或系统钥匙串，代码里不留任何兜底明文

# ── 翻译通道（Command Code Provider API）─────────────────────
# 推荐存进 macOS 钥匙串（系统加密保管，项目文件不留明文）：
#   security add-generic-password -a commandcode -s localization-translator -w '<你的密钥>' -U
# 用钥匙串时这里留空即可；也可以直接填在下方，或 export 同名环境变量
# 优先级：真实环境变量 > 本文件里显式填写的值 > macOS 钥匙串
COMMANDCODE_API_KEY=
COMMANDCODE_BASE_URL=https://api.commandcode.ai/provider/v1

# ── 配音通道（TTSMaker 官方开发者 API）──────────────────────
# 留空则配音功能不可用，翻译流程不受影响
TTSMAKER_TOKEN=
